{
  "name": "@clime/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "CLIME AI Growth Studio — Electron desktop shell",
  "author": "CLIME",
  "homepage": "https://github.com/phonarawd/ai-",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-renderer.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "rebuild:electron-native": "node scripts/ensure-electron-native.mjs",
    "rebuild:node-native": "pnpm --filter @clime/storage exec npm rebuild better-sqlite3",
    "start": "node scripts/ensure-electron-native.mjs && electron .",
    "pack": "pnpm run rebuild:electron-native && pnpm run build && electron-builder --dir --publish never && node scripts/fix-unpacked-native.mjs",
    "dist:win": "pnpm run rebuild:electron-native && pnpm run build && electron-builder --win nsis --publish never && node scripts/fix-unpacked-native.mjs",
    "ship:smoke": "pnpm run pack"
  },
  "dependencies": {
    "@clime/account": "workspace:*",
    "@clime/analytics": "workspace:*",
    "@clime/automation": "workspace:*",
    "@clime/browser-automation": "workspace:*",
    "@clime/config": "workspace:*",
    "@clime/content": "workspace:*",
    "@clime/domain-api": "workspace:*",
    "@clime/growth-decision": "workspace:*",
    "@clime/growth-knowledge": "workspace:*",
    "@clime/growth-planning": "workspace:*",
    "@clime/growth-research": "workspace:*",
    "@clime/growth-revenue": "workspace:*",
    "@clime/learning": "workspace:*",
    "@clime/memory": "workspace:*",
    "@clime/meta": "workspace:*",
    "@clime/notification": "workspace:*",
    "@clime/observability": "workspace:*",
    "@clime/shared": "workspace:*",
    "@clime/storage": "workspace:*",
    "@clime/tool": "workspace:*",
    "@clime/ui": "workspace:*",
    "@clime/vault": "workspace:*",
    "@clime/workflow": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "electron-updater": "^6.8.9",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.4"
  }
}
